# ------------------------------------------------------------------
# Africhina Connect — Environment Variables (template)
#
# Copy to `.env.local` for development and fill in real values.
# `.env.local` is git-ignored; this template is committed.
#
# NOTE: Prisma auto-loads `.env` (not `.env.local`). During local development
# the app (Next.js) and Prisma both read `.env`, so keeping DB credentials in
# `.env` is the simplest setup. `.env`, `.env.local`, and `.env.*` are all
# git-ignored — only this `.env.example` is committed.
#
# Only foundation-level variables are listed here. Service credentials
# (auth, Cloudinary, Paystack, Flutterwave, Resend) are added in their own
# Phase 0 stories when those integrations are configured.
# ------------------------------------------------------------------

# Public base URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App environment: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
#
# DATABASE_URL         Pooled connection used by the app at runtime.
# DIRECT_DATABASE_URL  Direct (non-pooled) connection used by the Prisma CLI
#                      for migrations and introspection.
#
# --- Local development ---
# With a local PostgreSQL, both URLs are identical (no pooler locally):
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/africhina_dev?schema=public"
#   DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/africhina_dev?schema=public"
#
# --- Neon (production/staging) ---
# Neon provides two hosts. Use the POOLED host (contains "-pooler") for
# DATABASE_URL and the DIRECT host (no "-pooler") for DIRECT_DATABASE_URL.
# Always require TLS with sslmode=require.
#
# Neon suspends the compute when idle (scale-to-zero). The first connection
# after a suspend wakes it and can exceed Prisma's default 5s connect timeout
# (error P1001). Add connect_timeout=15 so cold starts succeed. channel_binding
# is optional hardening and is supported by Prisma.
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require&connect_timeout=15"
#   DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require&connect_timeout=15"
# ------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/africhina_dev?schema=public"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/africhina_dev?schema=public"
# Resend email service
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@africhinaconnect.com"
