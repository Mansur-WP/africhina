// Africhina Connect — Prisma schema
// Docs: https://pris.ly/d/prisma-schema
// Database source of truth: docs/database-erd.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// Enums

enum RoleCode {
  guest
  buyer
  supplier
  logistics
  agent
  admin
}

enum UserStatus {
  active
  suspended
  pending
}

enum SupplierVerificationStatus {
  pending
  verified
  rejected
}

enum ProductStatus {
  draft
  active
  inactive
}

enum RFQStatus {
  open
  quoted
  accepted
  closed
}

enum QuotationStatus {
  draft
  pending
  sent
  accepted
  rejected
}

enum OrderStatus {
  draft
  pending_payment
  paid
  in_production
  ready_to_ship
  shipped
  in_customs
  delivered
  completed
  cancelled
  refunded
  disputed
}

enum PaymentProvider {
  paystack
  flutterwave
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum EscrowStatus {
  held
  released
  refunded
}

enum ShipmentStatus {
  preparing
  in_transit
  in_customs
  delivered
}

enum NotificationType {
  order
  payment
  shipping
  system
}

enum NotificationRead {
  unread
  read
}

enum Currency {
  NGN
  CNY
  USD
}

enum VerificationTokenType {
  emailVerification
  passwordReset
}

// Models

model Role {
  id        String   @id @default(cuid())
  code      RoleCode @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  roleId        String
  status        UserStatus @default(active)
  phone         String?
  avatarUrl     String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  role          Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions      Session[]
  verificationTokens VerificationToken[]
  orders        Order[]   @relation("buyerOrders")
  tickets       Ticket[]  @relation("customerTickets")
  assignedTickets Ticket[] @relation("ticketAssignee")
  ticketReplies TicketReply[] @relation("authorReplies")
  notifications Notification[]
  reviews       Review[]  @relation("buyerReviews")
  attachments   Attachment[] @relation("uploaderAttachments")
  shipmentsAssigned Shipment[] @relation("assigneeShipments")
  supplier      Supplier? @relation("SupplierUser")
  rfqs          RFQ[]
  shipmentEvents ShipmentEvent[] @relation("UserCreatedShipmentEvents")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String                     @id @default(cuid())
  token     String                     @unique
  userId    String
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime                   @default(now())

  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Supplier {
  id                    String   @id @default(cuid())
  userId                String   @unique
  companyName           String?
  country               String?
  verificationStatus    SupplierVerificationStatus @default(pending)
  rating                Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  user                  User     @relation("SupplierUser", fields: [userId], references: [id], onDelete: Restrict)
  products              Product[]
  quotations            Quotation[]
  supplierDocuments     SupplierDocument[]
  orders                Order[]  @relation("SupplierOrders")
  reviews               Review[] @relation("SupplierReviews")
}

model SupplierDocument {
  id         String  @id @default(cuid())
  supplierId String
  type       String
  url        String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent    Category? @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToCategory")
  products  Product[]

  @@index([parentId])
}

model Product {
  id               String       @id @default(cuid())
  supplierId       String
  categoryId       String
  title            String
  description      String?
  // price stored in minor units (e.g., kobo/ngn cents)
  price            Int
  currency         Currency     @default(NGN)
  minimumOrderQty  Int?
  stock            Int?
  status           ProductStatus @default(draft)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  supplier         Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  orderItems       OrderItem[]
  rfqItems         RFQItem[]
  reviews          Review[]     @relation("ProductReviews")

  @@index([supplierId])
  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int?
  createdAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model RFQ {
  id              String    @id @default(cuid())
  referenceNumber String?   @unique
  buyerId         String
  title           String?
  description     String?
  destination     String?
  status          RFQStatus @default(open)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  buyer       User      @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items       RFQItem[]
  quotations  Quotation[]

  @@index([buyerId])
  @@index([status])
}

model RFQItem {
  id        String  @id @default(cuid())
  rfqId     String
  productId String?
  quantity  Int?
  notes     String?

  rfq       RFQ     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([rfqId])
  @@index([productId])
}

model Quotation {
  id               String         @id @default(cuid())
  referenceNumber  String?        @unique
  rfqId            String
  supplierId       String
  // All monetary values are integer minor units (for example, kobo/cents).
  productCost              Int
  chinaShippingCost        Int
  inspectionCost            Int
  internationalFreightCost Int
  customsCost               Int
  serviceFee                Int
  otherCharges              Int
  total                    Int
  currency         Currency       @default(NGN)
  deliveryEstimate String?
  notes            String?
  status           QuotationStatus @default(pending)
  expiresAt        DateTime?
  sentAt           DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  rfq              RFQ            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier         Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orders           Order[]

  @@index([rfqId])
  @@index([supplierId])
  @@index([status])
  @@index([expiresAt])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  buyerId       String
  supplierId    String
  quotationId   String?
  status        OrderStatus @default(draft)
  // Totals in minor units
  totalAmount   Int
  currency      Currency    @default(NGN)
  shippingAddress String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  buyer         User        @relation("buyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  supplier      Supplier    @relation("SupplierOrders", fields: [supplierId], references: [id], onDelete: Restrict)
  quotation     Quotation?  @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      Payment[]
  invoice       Invoice?
  escrow        Escrow?
  shipments     Shipment[]
  tickets       Ticket[]
  reviews       Review[]

  @@index([buyerId])
  @@index([supplierId])
  @@index([status])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String?
  quantity   Int
  unitPrice  Int      // minor units
  subtotal   Int

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Escrow {
  id         String       @id @default(cuid())
  orderId    String       @unique
  amount     Int
  currency   Currency     @default(NGN)
  status     EscrowStatus @default(held)
  releasedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  order      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Payment {
  id            String         @id @default(cuid())
  orderId       String
  provider      PaymentProvider
  providerRef   String         @unique
  amount        Int
  currency      Currency       @default(NGN)
  status        PaymentStatus  @default(pending)
  webhookPayload Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoice       Invoice?       @relation("PaymentInvoice")

  @@index([orderId])
  @@index([status])
}

model Invoice {
  id           String   @id @default(cuid())
  orderId      String   @unique
  paymentId    String?
  invoiceNumber String  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment      Payment? @relation("PaymentInvoice", fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([paymentId])
  @@index([orderId])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  assigneeId     String?
  carrier        String?
  trackingNumber String?   @unique
  status         ShipmentStatus @default(preparing)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignee       User?     @relation("assigneeShipments", fields: [assigneeId], references: [id], onDelete: SetNull)
  events         ShipmentEvent[]
  documents      ShippingDocument[]

  @@index([assigneeId])
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  createdById String?
  status      ShipmentStatus
  description String?
  location    String?
  occurredAt  DateTime @default(now())

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("UserCreatedShipmentEvents", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([occurredAt])
}

model ShippingDocument {
  id           String @id @default(cuid())
  shipmentId   String
  attachmentId String
  type         String?
  createdAt    DateTime @default(now())

  shipment     Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  attachment   Attachment @relation("AttachmentShippingDocuments", fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
}

model Ticket {
  id          String   @id @default(cuid())
  customerId  String
  assigneeId  String?
  orderId     String?
  subject     String?
  body        String?
  status      String?
  priority    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    User     @relation("customerTickets", fields: [customerId], references: [id], onDelete: Restrict)
  assignee    User?    @relation("ticketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  replies     TicketReply[]

  @@index([customerId])
  @@index([assigneeId])
  @@index([status])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation("authorReplies", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      NotificationType
  title     String?
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  buyerId    String
  productId  String?
  supplierId String?
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyer      User     @relation("buyerReviews", fields: [buyerId], references: [id], onDelete: Restrict)
  product    Product? @relation("ProductReviews", fields: [productId], references: [id], onDelete: SetNull)
  supplier   Supplier?@relation("SupplierReviews", fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([buyerId])
  @@index([productId])
  @@index([supplierId])
}

model Attachment {
  id         String   @id @default(cuid())
  uploadedBy String?
  url        String
  fileName   String?
  mimeType   String?
  ownerType  String?
  ownerId    String?
  createdAt  DateTime @default(now())
  deletedAt  DateTime?

  uploader   User?    @relation("uploaderAttachments", fields: [uploadedBy], references: [id], onDelete: SetNull)
  shippingDocuments ShippingDocument[] @relation("AttachmentShippingDocuments")

  @@index([uploadedBy])
  @@index([ownerType, ownerId])
}

// End of schema
